{
  "name": "@xz-lang/bridge",
  "version": "0.1.0-draft",
  "private": true,
  "description": "Generate typed TypeScript bindings for Xz shared libraries and load them via Bun FFI or Node koffi.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "bun": "^1.4.2",
    "koffi": "^2.16.3"
  },
  "peerDependencies": {
    "koffi": "^2.16.3"
  },
  "peerDependenciesMeta": {
    "koffi": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
